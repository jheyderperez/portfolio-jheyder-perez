---
import { siteConfig, type Lang } from "../config";
import { t, ui } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = siteConfig.social;

type Pub = (typeof siteConfig.publications)[number];

const escapeHtml = (x: string) => x.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// Resalta su nombre en la lista de autores.
// Los coautores con página propia (siteConfig.coauthors) enlazan a ella.
const authorsHtml = (a: string) => {
  let html = escapeHtml(a).replace(/(Perez,? J\.)/g, "<strong>$1</strong>");
  for (const [name, url] of Object.entries(siteConfig.coauthors)) {
    html = html.split(escapeHtml(name)).join(`<a class="prose-link" href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(name)}</a>`);
  }
  return html;
};

function byYear<T extends { year: string }>(items: T[]): Array<[string, T[]]> {
  const groups = new Map<string, T[]>();
  for (const item of items) {
    if (!groups.has(item.year)) groups.set(item.year, []);
    groups.get(item.year)!.push(item);
  }
  return [...groups.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
}

const sections: Array<{ key: Pub["type"]; label: string }> = [
  { key: "journal", label: t(ui.journal, lang) },
  { key: "conference", label: t(ui.conference, lang) },
  { key: "thesis", label: t(ui.thesis, lang) },
];
---

<h1 class="serif text-3xl sm:text-4xl" style="color: var(--ink)">{lang === "es" ? "Publicaciones" : "Publications"}</h1>
<p class="mt-3 text-[17px] leading-relaxed" style="color: var(--muted)">
  {t(ui.pubsIntro, lang)}{" "}
  <a class="prose-link" href={s.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>{" "}
  {t(ui.and, lang)}{" "}
  <a class="prose-link" href={s.researchgate} target="_blank" rel="noopener noreferrer">ResearchGate</a>.
</p>

{sections.map((sec) => {
  const items = siteConfig.publications.filter((p) => p.type === sec.key);
  if (items.length === 0) return null;
  return (
    <section class="mt-12">
      <h2 class="section-title">{sec.label}</h2>
      <div class="divide-y divide-[var(--line)]">
        {byYear(items).map(([year, pubs]) => (
          <div class="py-5 first:pt-0 md:grid md:grid-cols-[1fr_90px] md:gap-6">
            <p class="md:order-2 md:text-right text-2xl md:text-3xl font-light tabular-nums mb-3 md:mb-0" style="color: #9aa5ad">{year}</p>
            <ul class="md:order-1 space-y-6">
              {pubs.map((p) => (
                <li>
                  <p class="font-semibold leading-snug text-[17px]" style="color: var(--ink)">{p.title}</p>
                  <p class="mt-1 text-[15px]" style="color: var(--ink)" set:html={authorsHtml(p.authors)} />
                  <p class="mt-0.5 text-[15px] italic" style="color: var(--muted)">{t(p.venue, lang)}</p>
                  {(p.status || p.link) && (
                    <div class="mt-2.5 flex flex-wrap items-center gap-2">
                      {p.status && <span class="chip">{t(p.status, lang)}</span>}
                      {p.link && (
                        <a class="mini-btn" href={p.link} target="_blank" rel="noopener noreferrer">{t(ui.view, lang)} ↗</a>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  );
})}

{siteConfig.talks.length > 0 && (
  <section class="mt-12">
    <h2 class="section-title">{t(ui.talks, lang)}</h2>
    <div class="divide-y divide-[var(--line)]">
      {byYear(siteConfig.talks).map(([year, talks]) => (
        <div class="py-5 first:pt-0 md:grid md:grid-cols-[1fr_90px] md:gap-6">
          <p class="md:order-2 md:text-right text-2xl md:text-3xl font-light tabular-nums mb-3 md:mb-0" style="color: #9aa5ad">{year}</p>
          <ul class="md:order-1 space-y-5">
            {talks.map((x) => (
              <li>
                <p class="font-semibold leading-snug text-[17px]" style="color: var(--ink)">{lang === "es" ? `«${x.title}»` : `“${x.title}”`}</p>
                <p class="mt-1 text-[15px] italic" style="color: var(--muted)">{t(x.venue, lang)}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
