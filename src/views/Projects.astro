---
import { siteConfig, type Lang } from "../config";
import { t, ui } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;

const isPlaceholder = (x: string) => x.includes("<<PLACEHOLDER");
---

<h1 class="serif text-3xl sm:text-4xl" style="color: var(--ink)">{lang === "es" ? "Proyectos" : "Projects"}</h1>

<section class="mt-10">
  <h2 class="section-title">{t(ui.researchProjects, lang)}</h2>
  <ul class="space-y-8">
    {siteConfig.researchProjects.map((p) => (
      <li class="md:grid md:grid-cols-[1fr_170px] md:gap-6">
        <p class="md:order-2 md:text-right text-sm tabular-nums mb-1 md:mb-0 md:pt-1" style="color: var(--muted)">{t(p.dateRange, lang)}</p>
        <div class="md:order-1">
          <h3 class="font-semibold text-[17px] leading-snug" style="color: var(--ink)">
            {p.link ? <a class="prose-link" href={p.link} target="_blank" rel="noopener noreferrer">{t(p.name, lang)}</a> : t(p.name, lang)}
          </h3>
          <p class="text-[15px] font-semibold mt-0.5" style="color: var(--accent)">{t(p.role, lang)}</p>
          <p class="mt-1.5 text-[16px] leading-relaxed" style="color: var(--muted)">{t(p.description, lang)}</p>
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {p.tags.map((tag) => <span class="chip">{t(tag, lang)}</span>)}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<section class="mt-14" id="codigo">
  <h2 class="section-title">{t(ui.codeProjects, lang)}</h2>
  <p class="text-[16px] mb-5" style="color: var(--muted)">{t(ui.codeProjectsIntro, lang)}</p>
  <ul class="grid gap-4 sm:grid-cols-2">
    {siteConfig.codeProjects.map((p) => {
      const name = t(p.name, lang);
      const pending = isPlaceholder(name) || !p.github;
      return (
        <li class:list={["rounded p-5 flex flex-col", pending ? "placeholder-box" : "border"]} style={pending ? "" : "border-color: var(--line)"}>
          <div class="flex items-start gap-2.5">
            <svg class="w-5 h-5 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 24 24" style="color: var(--ink)" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <h3 class="font-semibold text-[17px] leading-snug break-words" style="color: var(--ink)">{name}</h3>
          </div>
          <p class="mt-2 text-[15px] leading-relaxed flex-1" style="color: var(--muted)">{t(p.description, lang)}</p>
          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            {p.tags.map((tag) => <span class="chip">{t(tag, lang)}</span>)}
          </div>
          <div class="mt-4">
            {p.github
              ? <a class="mini-btn" href={p.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              : <span class="text-xs font-semibold" style="color: #b45309">&lt;&lt;PLACEHOLDER: link al repositorio en GitHub&gt;&gt;</span>}
          </div>
        </li>
      );
    })}
  </ul>
</section>

<section class="mt-14">
  <h2 class="section-title">{t(ui.consulting, lang)}</h2>
  <div class="grid gap-6 sm:grid-cols-2">
    {siteConfig.services.map((sv) => (
      <div>
        <h3 class="font-semibold text-[17px]" style="color: var(--ink)">{t(sv.title, lang)}</h3>
        <p class="mt-1 text-[15px] leading-relaxed" style="color: var(--muted)">{t(sv.description, lang)}</p>
      </div>
    ))}
  </div>

  <h3 class="mt-8 mb-3 text-sm font-semibold uppercase tracking-wider" style="color: var(--accent)">{t(ui.selectedWork, lang)}</h3>
  <ul class="divide-y divide-[var(--line)] border-y border-[var(--line)]">
    {siteConfig.consultingProjects.map((c) => (
      <li class="py-3 md:grid md:grid-cols-[1fr_150px] md:gap-6">
        <div>
          <p class="text-[16px] leading-snug" style="color: var(--ink)">{t(c.name, lang)}</p>
          {t(c.client, lang) && <p class="text-[14px] mt-0.5" style="color: var(--muted)">{t(c.client, lang)}</p>}
        </div>
        <p class="text-sm tabular-nums mt-1 md:mt-0 md:text-right" style="color: var(--muted)">{t(c.date, lang)}</p>
      </li>
    ))}
  </ul>
</section>
