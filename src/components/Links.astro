---
// Enlaces a perfiles académicos y de contacto, como botones de texto.
import { siteConfig } from "../config";
const s = siteConfig.social;
const links = [
  s.email && { label: "Email", href: `mailto:${s.email}`, external: false },
  s.scholar && { label: "Google Scholar", href: s.scholar, external: true },
  s.researchgate && { label: "ResearchGate", href: s.researchgate, external: true },
  s.linkedin && { label: "LinkedIn", href: s.linkedin, external: true },
  s.github && { label: "GitHub", href: s.github, external: true },
  s.whatsapp && { label: "WhatsApp", href: s.whatsapp, external: true },
].filter(Boolean) as Array<{ label: string; href: string; external: boolean }>;
---

<ul class="flex flex-wrap gap-2">
  {links.map((l) => (
    <li>
      <a
        href={l.href}
        {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        class="inline-flex items-center px-3 py-1.5 text-sm font-semibold rounded border transition-colors hover:text-white hover:bg-[var(--accent)] hover:border-[var(--accent)]"
        style="color: var(--accent); border-color: color-mix(in srgb, var(--accent) 35%, white)"
      >
        {l.label}
      </a>
    </li>
  ))}
</ul>
